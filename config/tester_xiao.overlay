#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        label = "default_kscan";

        col-gpios = <
            &gpio0 4 GPIO_ACTIVE_HIGH  /* D4 */
            &gpio1 5  GPIO_ACTIVE_HIGH  /* D5 */
            &gpio0 6 GPIO_ACTIVE_HIGH  /* D6 */
        >;

        row-gpios = <
            &gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)  /* D0 */
            &gpio0 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)  /* D1 */
            &gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)  /* D2 */
            &gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)  /* D3 */
        >;

    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
            RC(1,0) RC(1,1) RC(1,2)
            RC(2,0) RC(2,1) RC(2,2)
            RC(3,0) RC(3,1) RC(3,2)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    lencoder: lencoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D7 */
        b-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D8 */
        steps = <24>;
        status = "okay";
    };

    rencoder: rencoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D9 */
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D10 */
        steps = <24>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&lencoder>, <&rencoder>;
        triggers-per-rotation = <20>;
    };
};