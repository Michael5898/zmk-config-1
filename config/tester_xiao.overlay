/ {
    // Matrix
    rows = <4>;
    columns = <3>;
    row-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>, <&gpio0 1 GPIO_ACTIVE_LOW>,
                <&gpio0 2 GPIO_ACTIVE_LOW>, <&gpio0 3 GPIO_ACTIVE_LOW>;
    col-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>, <&gpio0 5 GPIO_ACTIVE_LOW>, <&gpio0 6 GPIO_ACTIVE_LOW>;

    encoders {
        compatible = "zmk,encoders";
        #address-cells = <1>;
        #size-cells = <0>;

        left_encoder: encoder_left {
            compatible = "alps,ec11";
            a-gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            b-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            steps = <24>;
            status = "okay";
        };

        right_encoder: encoder_right {
            compatible = "alps,ec11";
            a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            steps = <24>;
            status = "okay";
        };
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };

    behaviors {
        rot_vol: sensor_rotate_vol {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
        };

        rot_pg: sensor_rotate_pg {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
        };
    };
};
