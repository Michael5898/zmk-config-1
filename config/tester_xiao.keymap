#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                //-----------------------------
                //              mute        layer
                //
                //  rew         play        skip
                //
                //  Copy        Paste       Cut
                //
                //  HeadMuteDC  DC-Mute     Undo
                &rot_vol C_VOL_UP C_VOL_DN
                &rot_pg PG_UP PG_DN
                            &kp C_MUTE      &tog 1

                    &kp C_PREV  &kp C_PP    &kp C_NEXT

                    &kp LCTRL(C)   &kp LCTRL(V)   &kp LCTRL(X)

                  &kp LC(LS(M)) &kp LC(LS(D)) &kp LC(Z)

            >;

        };

        num { // Layer 1
            display-name = "NUM";
            //------------------------------------
            //                  mute        layer
            //
            //      1           2           3
            //
            //      4           5           6
            //
            //      7           8           9
            bindings = <
                &rot_vol C_VOL_UP C_VOL_DN
                &rot_pg PG_UP PG_DN
                        &kp C_MUTE         &tog 1

                &kp 1        &kp 2         &kp 3

                &kp 4        &kp 5         &kp 6

                &kp 7        &kp 8         &kp 9
            >;
        };
    };
};