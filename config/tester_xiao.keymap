#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

//-----------------------------
//     Dead    C_Mute    TOGL LAYER 1
//
//  Rewind      Play/Pause  Skip
//
//  Copy        Paste     Cut
//
//  CTRL+SHFT+M CTRL+SHFT+D CTRL+Z

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            bindings = <
        &none         &kp C_MUTE    &tog 1
        &kp C_PREV    &kp C_PP      &kp C_NEXT
        &kp LC(C)     &kp LC(V)     &kp LC(X)
        &kp LC(LS(M)) &kp LC(LS(D)) &kp LC(Z)
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
            //label = "num";
                &none         &kp C_MUTE    &tog 0
                &kp 1         &kp 2         &kp 3
                &kp 4         &kp 5         &kp 6
                &kp 7         &kp 8         &kp 9
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        ble {
            display-name = "Bluetooth";
            bindings = <
                &none       &kp C_MUTE      &none
                &bt BT_CLR  &bt BT_CLR_ALL  &none
                &bt BT_PRV  &none           &bt BT_NXT
                &none       &none           &lt 2 LC(Z)
            >;
        };

    };
        extra1 {
            display-name = "extra1";
            status = "reserved";
        };
        extra2 {
            display-name = "extra2";
            status = "reserved";
        };
};
