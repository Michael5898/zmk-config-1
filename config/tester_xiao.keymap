#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                //-----------------------------
                //     empty   encoder1   encoder2
                //
                //  rew         play      skip
                //
                //  Copy        Paste     Cut
                //
                //  HeadMuteDC  DC-Mute   Undo
                &kp C_MUTE    &tog 1
                &kp C_PREV    &kp C_PP     &kp C_NEXT
                &kp LCTRL(C)  &kp LCTRL(V) &kp LCTRL(X)
                &kp LC(LS(M)) &kp LC(LS(D)) &kp LC(Z)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num { // Layer 1
            display-name = "NUM";
            bindings = <
                &kp C_MUTE    &tog 1
                &kp 1         &kp 2         &kp 3
                &kp 4         &kp 5         &kp 6
                &kp 7         &kp 8         &kp 9
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
